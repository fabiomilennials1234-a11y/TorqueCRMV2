# Torque API — runtime configuration.
# Copy to `.env` and fill in real values. `.env` is in .gitignore.

# --- Environment ------------------------------------------------------
# Environment: dev | staging | prod
ENV=dev

# HTTP listen address
HTTP_ADDR=:8080

# --- Persistence ------------------------------------------------------
# PostgreSQL connection string (required)
DATABASE_URL=postgres://torque:torque@localhost:5432/torque?sslmode=disable

# --- Logging ----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# --- HTTP timeouts ----------------------------------------------------
SHUTDOWN_TIMEOUT=15s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# --- CORS -------------------------------------------------------------
# Comma-separated allow-list. Empty = closed (default in prod).
CORS_ORIGINS=http://localhost:5173

# --- Auth / Session (S02) --------------------------------------------
# JWT_SECRET: HS256 signing key. MUST be >= 32 bytes. Generate with:
#   openssl rand -base64 48
# Never commit a real value.
# Rotation: 12 months or on suspected leak. Procedure + escrow:
#   .specs/runbooks/key-rotation.md ("Generic Rotation")
JWT_SECRET=replace-me-with-a-48-byte-base64-string-aaaaaaaaaaaaaa

# Access-token TTL. Short by design (paired with refresh rotation).
ACCESS_TTL=15m

# Refresh-token TTL. 30 days is the ADR-003 default.
REFRESH_TTL=720h

# Parent domain for auth cookies. Empty = host-only (recommended for dev).
# Use .torquecrm.com (with leading dot) to scope across subdomains.
COOKIE_DOMAIN=

# Force Secure flag on cookies. False only in dev over plain http.
# In staging/prod this is forced to true regardless.
COOKIE_SECURE=false

# --- Bootstrap payload (public, served to unauthenticated clients) ----
APP_VERSION=dev
WS_URL=ws://localhost:8080/api/v1/ws

# --- Observability (S03) ---------------------------------------------
# SENTRY_DSN: SERVER-side DSN. Private — never shipped to the browser.
SENTRY_DSN=

# SENTRY_PUBLIC_DSN: CLIENT-side DSN. Shipped via /api/bootstrap to the
# browser. Can be the same project as SENTRY_DSN or a separate one.
SENTRY_PUBLIC_DSN=

# Sentry environment label. Defaults to ENV when empty.
SENTRY_ENVIRONMENT=

# Event sample rate in [0,1]. 1.0 ships every event; lower in high-volume prod.
SENTRY_SAMPLE_RATE=1.0

# Trace sample rate in [0,1]. 0.0 = traces off (default).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Rate limiting (S03) ---------------------------------------------
# In-memory token bucket. Distributed mode (Redis) is out of S03 scope.
RATELIMIT_ANON_RPS=5
RATELIMIT_ANON_BURST=10
RATELIMIT_USER_RPS=30
RATELIMIT_USER_BURST=60

# When behind a trusted reverse proxy (nginx/EasyPanel), set to true so the
# limiter uses the leftmost X-Forwarded-For IP instead of the proxy address.
RATELIMIT_TRUST_PROXY=false

# --- Feature flags exposed in /api/bootstrap -------------------------
# Shape: "flag1=true,flag2=false". Never put security-sensitive gates here.
FEATURE_FLAGS=

# --- Billing (S24, S51 — Asaas) --------------------------------------
# Billing provider: "mock" | "asaas". In prod must be "asaas".
BILLING_PROVIDER=mock

# Shared-secret header for provider webhooks (Asaas forwards signed callbacks).
# Generate with: openssl rand -base64 32
# Rotation: 12 months or on suspected leak. Touches money — Sev1 if leaked.
# Procedure: .specs/runbooks/key-rotation.md ("Generic Rotation").
BILLING_WEBHOOK_SECRET=

# Asaas credentials. Required when BILLING_PROVIDER=asaas (dual-review tripwire
# refuses to boot with empty key).
# Rotation: 6 months. Revoke at Asaas dashboard first on any leak signal.
# Procedure: .specs/runbooks/key-rotation.md ("Generic Rotation").
ASAAS_API_KEY=
# Default base URL points to production Asaas. Override with sandbox in staging:
#   https://sandbox.asaas.com/api/v3
ASAAS_BASE_URL=https://www.asaas.com/api/v3

# --- AI providers (S37, S39, S41) ------------------------------------
# OpenRouter — chat/stream LLM gateway.
# Rotation: 12 months. Leak risk is quota-burn (Sev2), not data exfil.
# Procedure: .specs/runbooks/key-rotation.md ("Generic Rotation").
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://torque.app
OPENROUTER_TITLE=Torque CRM

# Gemini — embeddings for RAG (S39). 768-dim text-embedding-004.
# Rotation: 12 months. See .specs/runbooks/key-rotation.md.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ElevenLabs — TTS (S41). Empty key falls back to deterministic mock.
# Rotation: 12 months. See .specs/runbooks/key-rotation.md.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Integrations (S49, S50) -----------------------------------------
# AES-256-GCM key encrypting OAuth tokens in integration_credentials.
# MUST be 32 raw bytes base64-encoded. Non-dev boot fails if empty.
# Generate with: openssl rand -base64 32
#
# !! MOST SENSITIVE KEY IN THE SYSTEM !!
# Losing it = permanent loss of every tenant's third-party OAuth refresh
# tokens (Google, Meta, TinyERP, SZ.Chat). Leaking it lets attackers
# decrypt stolen DB dumps offline.
# Rotation: 6 months OR on suspected leak. REQUIRES dual-key procedure
# and a re-encryption worker — do NOT single-step swap.
# Full procedure + escrow: .specs/runbooks/key-rotation.md
# ("Procedure — INTEGRATION_ENCRYPTION_KEY (most sensitive)").
INTEGRATION_ENCRYPTION_KEY=

# HMAC secret for OAuth state parameter (fallback to JWT_SECRET when empty).
INTEGRATION_STATE_SECRET=

# Google OAuth (Calendar integration).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google/callback

# TinyERP REST v2 (Brazilian ERP, F15).
TINYERP_BASE_URL=https://api.tiny.com.br/api2

# Meta Graph API (Meta Ads Insights + Lead Ads webhook, S50).
META_GRAPH_BASE_URL=https://graph.facebook.com/v18.0
# App secret used to compute appsecret_proof and verify Lead Ads webhook signatures.
# Rotation: 12 months or on suspected leak. Rotate via Meta App Dashboard
# first, then update env. See .specs/runbooks/key-rotation.md.
META_APP_SECRET=

# SZ.Chat messaging provider.
SZCHAT_BASE_URL=https://api.szchat.com/v1

# --- Lead ingest webhook (S50) ---------------------------------------
# HMAC-SHA256 secret for POST /webhooks/lead signature header
# (X-Torque-Lead-Signature: sha256=<hex>). Empty = 503 fail-closed.
# Rotation: 12 months or on suspected leak. Requires coordination with
# every upstream sender (n8n, Meta proxy, etc.) before cutover.
# Procedure: .specs/runbooks/key-rotation.md ("Generic Rotation").
LEAD_WEBHOOK_SECRET=
