# Torque API — runtime configuration.
# Copy to `.env` and fill in real values. `.env` is in .gitignore.

# Environment: dev | staging | prod
ENV=dev

# HTTP listen address
HTTP_ADDR=:8080

# PostgreSQL connection string (required)
DATABASE_URL=postgres://torque:torque@localhost:5432/torque?sslmode=disable

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Graceful shutdown budget
SHUTDOWN_TIMEOUT=15s

# HTTP server timeouts
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# CORS allow-list (comma-separated). Empty = closed (default in prod).
CORS_ORIGINS=http://localhost:5173
