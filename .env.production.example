# Torque CRM v2 — Production env template (S67).
#
# This file documents EVERY env var the production stack consumes. Copy
# to a secret manager (1Password Torque Ops vault) per environment
# (staging vs production). NEVER commit a populated copy.
#
# Wiring map:
#   docker-compose.prod.yml      — references ${VAR} from this set
#   .github/workflows/deploy.yml — pushes vars/secrets into Environments
#   torque-api/internal/config   — config.go:Load() reads them
#
# Each section maps to a deferred or live integration. Vazio em provider
# externo = mock fallback (com WARN log) por design (D050/D072 dual-review
# tripwires). Producao com credencial real = "live"; staging com sandbox = OK.

# --- Core ----------------------------------------------------------------
ENV=prod                                      # dev | staging | prod
HTTP_ADDR=:8080
LOG_LEVEL=info                                # debug | info | warn | error
SHUTDOWN_TIMEOUT=15s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# --- Database (managed Postgres + pgvector) ------------------------------
# Hostinger managed instance OU container pgvector/pgvector:pg15. Migration
# 0019 exige extension `vector`.
DATABASE_URL=postgres://USER:PASS@HOST:5432/torque?sslmode=require

# --- Auth / cookies ------------------------------------------------------
# JWT_SECRET: min 32 bytes (config.go:267 enforce). Rotate trimestral.
# Procedure rotacao: .specs/runbooks/key-rotation.md
JWT_SECRET=                                   # 64 bytes hex recomendado
ACCESS_TTL=15m
REFRESH_TTL=720h
# COOKIE_DOMAIN setado no dominio publico (ex: .torquecrm.com.br) pra
# subdomain sharing app.torquecrm.com.br + api.torquecrm.com.br
COOKIE_DOMAIN=.torquecrm.com.br
COOKIE_SECURE=true                            # HTTPS-only — invariante prod

# --- CORS / CSRF ---------------------------------------------------------
# Lista CSV de origens permitidas (frontend prod + staging).
CORS_ORIGINS=https://app.torquecrm.com.br

# --- Webhooks (HMAC secrets) ---------------------------------------------
# BILLING_WEBHOOK_SECRET: HMAC-SHA256 sobre raw body (X-Torque-Signature)
# pra /webhooks/billing/webhook (provider-agnostic).
BILLING_WEBHOOK_SECRET=                       # 32+ bytes random
# LEAD_WEBHOOK_SECRET: HMAC-SHA256 sobre raw body (X-Torque-Lead-Signature)
# pra /webhooks/lead. Empty = 503 secure default.
LEAD_WEBHOOK_SECRET=                          # 32+ bytes random

# --- Integration credentials encryption (AES-256-GCM) --------------------
# 32-byte key base64-encoded. Rotacao = re-encrypt worker (D074-deferred,
# runbook key-rotation.md). NUNCA setar igual a JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=                   # base64(32 random bytes)
# INTEGRATION_STATE_SECRET: HMAC pra OAuth state TTL 10min. Pode reusar
# JWT_SECRET (config fallback) mas chave dedicada e cleaner.
INTEGRATION_STATE_SECRET=                     # base64(32 random bytes) opcional

# --- Billing provider (Asaas) --------------------------------------------
# BILLING_PROVIDER=asaas exige ASAAS_API_KEY != "" (NewAsaas em
# service/billing/asaas.go:99 retorna error em key vazia → main.go cai
# em mock + WARN log — D072 dual-review tripwire). Em prod sem key:
# system roda mas charges nao funcionam.
BILLING_PROVIDER=mock                         # mock | asaas
ASAAS_API_KEY=                                # https://www.asaas.com/api/v3 (production)
ASAAS_BASE_URL=https://api.asaas.com/v3       # sandbox: sandbox.asaas.com/api/v3

# --- AI providers --------------------------------------------------------
# OPENROUTER_API_KEY vazio → mock provider em service/ai/openrouter.go.
# Playground SSE retorna fake response com WARN. Prod sem key = Copilot
# nao funciona.
OPENROUTER_API_KEY=                           # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GEMINI: usado em service/ai/embeddings.go pra RAG (768-dim). Vazio →
# MockEmbedder (SHA256-chained, retrieval quality fake).
GEMINI_API_KEY=                               # https://aistudio.google.com/apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# ELEVENLABS: TTS preview no Playground + outbound message.audio future.
# Vazio → MockTTS (audio/mpeg fake silente).
ELEVENLABS_API_KEY=                           # https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Google OAuth (Calendar) ---------------------------------------------
# OAuth Client ID + Secret. Redirect URL whitelisted no GCP Console.
GOOGLE_OAUTH_CLIENT_ID=                       # https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.torquecrm.com.br/api/v1/integrations/google/callback

# --- Meta (Ads Insights + Lead Ads webhooks) -----------------------------
# App secret pra appsecret_proof HMAC. Lead Ads webhook (D074-g) pendente.
META_GRAPH_BASE_URL=https://graph.facebook.com/v18.0
META_APP_SECRET=                              # Meta Developer Console → App Settings → Basic

# --- SZ.Chat (messaging multi-canal) -------------------------------------
# Base URL custom (per-tenant API key configurada via UI Integracoes).
# Vazio = SZ.Chat OFF.
SZCHAT_BASE_URL=                              # https://api.szchat.com OR self-hosted

# --- TinyERP (sync products) ---------------------------------------------
TINYERP_BASE_URL=https://api.tiny.com.br/api2

# --- Sentry (errors + tracing) -------------------------------------------
# DSN backend (Go). Public DSN frontend (browser). SENTRY_TRACES_RATE em
# prod normalmente 0.05-0.1 (pago por span).
SENTRY_DSN=                                   # https://sentry.io/settings/<org>/projects/<proj>/keys/
SENTRY_PUBLIC_DSN=                            # public DSN — ok pra ir no bundle
SENTRY_TRACES_RATE=0.1
# SENTRY_WEBHOOK: usado em backup.yml pra notificar falha. Internal
# integration com webhook URL.
SENTRY_WEBHOOK=

# --- Rate limiter --------------------------------------------------------
# RATELIMIT_TRUST_PROXY=true em prod atras de Caddy/CloudFlare (extrai IP
# real de X-Forwarded-For). RATE_LIMIT_BACKEND=redis (S66 deferred) trocara
# do in-memory single-pod pra Redis token bucket.
RATELIMIT_TRUST_PROXY=true
# RATE_LIMIT_BACKEND=memory                   # memory | redis (S66)
# REDIS_URL=                                  # redis://[:pass@]host:6379/0

# --- Feature flags / experiments -----------------------------------------
# Comma-separated. Empty = todos disabled.
FEATURE_FLAGS=

# --- Backup (referenced by .github/workflows/backup.yml) -----------------
# Estes vivem nos GitHub Environment secrets (staging + production), nao
# nas envs do container — listado aqui pra completude do mapa.
# DATABASE_URL_PROD=                          # cron pg_dump source
# BACKUP_S3_BUCKET=                           # s3://torque-backups (R2/B2/Spaces)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
