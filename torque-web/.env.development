# Dev-only environment (loaded by Vite when NODE_ENV=development).
#
# DO NOT commit production secrets here. Everything in this file is shipped
# to the browser in dev builds via `import.meta.env`.

# Dev-auth bypass. '1' skips /api/v1/auth/me and injects DEV_SESSION so the
# UI is walkable without a running backend. Vite constant-folds this branch
# out of production builds (import.meta.env.DEV === false there).
VITE_DEV_AUTH=1
